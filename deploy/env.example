# Copie para deploy/.env (fora do git) e preencha. Não há segredo: o serviço é público e só leitura.

# Endereço público: links da documentação, servidor da especificação OpenAPI e Host aceito em /mcp.
PUBLIC_URL=https://design.byescaleira.com

# Outros nomes aceitos em /mcp, separados por vírgula (proteção contra DNS rebinding). Opcional.
MCP_ALLOWED_HOSTS=
